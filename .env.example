# Optional: production defaults to https://abogadamica.vercel.app/.
# Change when connecting a custom domain.
SITE_URL=https://abogadamica.vercel.app/

# Optional Search Console verification code (not the complete HTML tag).
GOOGLE_SITE_VERIFICATION=


---
import { Image } from 'astro:assets';
import Arrow from '../components/Arrow.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import estudio from '../assets/portada-estudio.jpg';
import micaela from '../assets/micaela-estudio.jpg';
import { business, socials, practiceAreas, contactQuestions, whatsappFor } from '../data/site';
const whatsapp = whatsappFor();
---
<SiteLayout>
  <main id="contenido">
    <section class="hero" id="inicio">
      <div class="hero-copy"><p class="eyebrow">MICAELA SPINA · ABOGADA</p><h1>Asesoramiento legal, <em>con una mirada cercana.</em></h1><p class="intro">Derecho de Familia y otras áreas. Atención en Bahía Blanca y Choele Choel.</p><a class="button" href={whatsapp} data-contact="whatsapp" data-origin="portada">Consultar por WhatsApp <Arrow /></a><p class="note">Presencial y virtual · Con turno previo</p></div>
      <div class="hero-photo"><Image src={estudio} alt="Escritorio de Micaela Spina con su computadora" widths={[480, 800, 1200]} sizes="(max-width: 760px) 88vw, 42vw" width={1200} format="webp" loading="eager" fetchpriority="high" /><div class="photo-note">Cada consulta empieza<br /><em>con una conversación.</em></div></div>
      <a class="scroll-hint" href="#areas">CONOCÉ CÓMO PUEDO AYUDARTE <Arrow direction="down" /></a>
    </section>
    <section id="areas" class="areas section">
      <div class="section-heading"><p class="eyebrow">ÁREAS DE PRÁCTICA</p><h2>Distintas situaciones.<br /><em>El mismo compromiso.</em></h2><p>Un acompañamiento profesional que parte de escuchar lo que necesitás.</p></div>
      <div class="family"><span class="number">01 /</span><div><p class="eyebrow">UN ÁREA CENTRAL DE MI PRÁCTICA</p><h3>Derecho de Familia</h3><p>Hay decisiones que atraviesan lo más personal. Contá con un espacio de escucha y asesoramiento para conversar sobre tu situación familiar y evaluar los pasos a seguir.</p><div class="family-actions"><a href="/familia/">Conocé cómo puedo acompañarte <Arrow /></a><a href={whatsappFor('Derecho de Familia')} data-contact="whatsapp" data-origin="area-familia">Consultar por WhatsApp <Arrow /></a></div></div><span class="family-symbol" aria-hidden="true">&</span></div>
      <div class="area-list">{practiceAreas.map((area, index) => <a class="area-row" href={whatsappFor(area.name)} data-contact="whatsapp" data-origin={`area-${area.slug}`}><span class="number">0{index + 2} /</span><div class="area-copy"><h3>{area.name}</h3><p>{area.description}</p><small>Consultar por WhatsApp</small></div><Arrow /></a>)}</div>
    </section>
    <section id="sobre-mi" class="about section"><div class="about-mark"><Image src={micaela} alt="Micaela Spina firmando un documento" widths={[280, 420, 560, 840]} sizes="(max-width: 760px) 280px, (max-width: 960px) 340px, 440px" width={800} format="webp" loading="lazy" /></div><div><p class="eyebrow">CONOCEME</p><h2>Micaela Spina.<br /><em>Abogada, con una<br />mirada cercana.</em></h2><p>Cuento con amplia experiencia en materia de familia, penal, sucesiones, amparos y jubilaciones, y soy Diplomada en Género, Igualdad y Derecho.</p><p>Ejerzo en las provincias de Buenos Aires y Río Negro, con atención en Bahía Blanca y Choele Choel. Mi propuesta es acompañarte con claridad y compromiso en cada consulta.</p><div class="credentials"><p class="credentials-title">Matrículas profesionales</p><ul><li><strong>Bahía Blanca</strong><span>Tº XXIII · Fº 17</span><small>Colegio de Abogados de Bahía Blanca</small></li><li><strong>Río Negro</strong><span>Matrícula 6549</span><small>Colegio de Abogados Gral. Roca</small></li><li><strong>Federal</strong><span>Tº 54 · Fº 918</span></li></ul></div></div></section>
    <section class="attention section"><div><p class="eyebrow">CERCA, ESTÉS DONDE ESTÉS</p><h2>Encontramos un momento<br /><em>para conversar.</em></h2></div><div class="modes"><article><span class="number">01</span><h3>En el estudio</h3><p>Atención presencial en Bahía Blanca y Choele Choel. Escribime y coordinamos el lugar y el horario de tu consulta.</p></article><article><span class="number">02</span><h3>Por videollamada</h3><p>Si preferís la modalidad virtual, podemos conversar por WhatsApp en un horario acordado.</p></article><article><span class="number">03</span><h3>Acorde a tus horarios</h3><p>Contame tu disponibilidad. Buscamos un momento para la consulta que se adapte a tus actividades.</p></article></div></section>
    <section id="contacto" class="contact section"><p class="eyebrow">DEMOS EL PRIMER PASO</p><h2>Tu consulta merece<br /><em>ser escuchada.</em></h2><p>Escribime y coordinamos un momento para conversar.</p><a class="button light" href={whatsapp}>Hablemos por WhatsApp <Arrow /></a><p class="maps-link"><a href={business.maps} target="_blank" rel="noopener noreferrer" data-contact="maps" data-origin="contacto">Ver ficha en Google Maps <Arrow /></a></p><div class="contact-links"><a href="tel:+542915351031">291 535 1031 <small>WhatsApp Business · Principal</small></a><a href="tel:+542984737131">2984 737131 <small>Teléfono alternativo · Río Negro</small></a><a href="mailto:abogadaspina@gmail.com">abogadaspina@gmail.com<small>Correo electrónico</small></a></div><div class="socials" aria-label="Redes sociales">{socials.map(social => <a href={social.url} target="_blank" rel="noopener noreferrer" data-contact={social.slug}><img src={`/images/${social.slug}.svg`} alt="" width="20" height="20" />{social.name}</a>)}</div></section>
    <section class="faq section"><div><p class="eyebrow">ANTES DE ESCRIBIRME</p><h2>Algunas preguntas<br /><em>para empezar.</em></h2></div><div class="questions">{contactQuestions.map(item => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div></section>
  </main>
</SiteLayout>
